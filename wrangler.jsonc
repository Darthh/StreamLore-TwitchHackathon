{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamlore",
  "main": "cloudflare/index.ts",
  "account_id": "f1bc349d0ee753076f1f03c19165ce75",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-worker",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/install",
      "/everywhere",
      "/everywhere/*",
      "/api/*",
      "/auth/*",
      "/twitch/*",
      "/channels/*"
    ],
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANNELS",
        "class_name": "StreamLoreChannel"
      },
      {
        "name": "EVERYWHERE",
        "class_name": "StreamLoreEverywhere"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StreamLoreChannel"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "StreamLoreEverywhere"
      ]
    }
  ],
  "vars": {
    "STREAMLORE_PUBLIC_URL": "https://streamlore.patrickvaldivia123.workers.dev",
    "TWITCH_EXTENSION_CLIENT_ID": "m7tirdtzbocxkfacsis37lvc81i4uc",
    "STREAMLORE_BOT_LOGIN": "streamerlore26",
    "STREAMLORE_MAX_VIEWERS": "40"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
